FROM ghcr.io/graalvm/graalvm-community:21-java21 AS build
RUN gu install native-image
RUN microdnf install -y \
    gcc \
    glibc-devel \
    zlib-devel \
    && microdnf clean all
WORKDIR /app
COPY gradle gradle
COPY gradlew .
COPY build.gradle .
COPY settings.gradle .
RUN chmod +x gradlew
RUN ./gradlew dependencies --no-daemon || true
COPY src src
RUN ./gradlew nativeCompile --no-daemon \
    -Porg.gradle.jvmargs="-Xmx4g -XX:MaxMetaspaceSize=1g" || \
    ./gradlew nativeBuild --no-daemon \
    -Porg.gradle.jvmargs="-Xmx4g -XX:MaxMetaspaceSize=1g"
RUN NATIVE_EXE=$(find build/native -type f -executable ! -name "*.so" ! -name "*.dylib" | head -1) && \
    if [ -z "$NATIVE_EXE" ]; then \
        echo "ERROR: Native executable not found!" && \
        echo "Searching in build directory:" && \
        find build -type f -executable 2>/dev/null | head -10 && \
        exit 1; \
    else \
        echo "Found native executable: $NATIVE_EXE" && \
        ls -lh "$NATIVE_EXE" && \
        cp "$NATIVE_EXE" /app/native-executable && \
        chmod +x /app/native-executable; \
    fi

FROM alpine:3.19
RUN apk add --no-cache \
    tzdata \
    ca-certificates \
    curl \
    && rm -rf /var/cache/apk/*
RUN addgroup -S spring && adduser -S spring -G spring
WORKDIR /app
COPY --from=build /app/native-executable /app/account-management
RUN chmod +x /app/account-management
RUN mkdir -p /app/logs && \
    chown -R spring:spring /app
USER spring:spring
EXPOSE 8080
ENV SPRING_PROFILES_ACTIVE=prod \
    TZ=UTC
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/actuator/health || exit 1
ENTRYPOINT ["/app/account-management"]
