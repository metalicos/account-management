# Account Management Application - Production Environment Variables
# Copy this file to .env and fill in the actual values
# Usage: docker run --env-file .env account-management:latest

# ============================================
# Spring Boot Profile
# ============================================
# Active Spring profile (should be 'prod' for production)
SPRING_PROFILES_ACTIVE=prod

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
# Database connection URL
# Format: jdbc:postgresql://host:port/database
# Example: jdbc:postgresql://postgres:5432/accountdb
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/accountdb

# Database username
SPRING_DATASOURCE_USERNAME=postgres

# Database password (REQUIRED - change this!)
SPRING_DATASOURCE_PASSWORD=your-secure-password-here

# ============================================
# JWT Security Configuration
# ============================================
# JWT secret key (REQUIRED - must be at least 256 bits/32 characters)
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your-secret-key-that-is-at-least-256-bits-long-for-hs256-algorithm-change-this

# JWT access token expiration time in milliseconds (default: 3600000 = 1 hour)
JWT_ACCESS_TOKEN_EXPIRATION=3600000

# JWT refresh token expiration time in milliseconds (default: 86400000 = 24 hours)
JWT_REFRESH_TOKEN_EXPIRATION=86400000

# ============================================
# Server Configuration
# ============================================
# Server port (default: 8080)
SERVER_PORT=8080

# ============================================
# Logging Configuration
# ============================================
# Log file path (default: ./logs/account-management.log)
LOG_FILE_PATH=./logs/account-management.log

# ============================================
# Java Runtime Options (Optional)
# ============================================
# JVM memory settings
# JAVA_OPTS=-Xmx512m -Xms256m

# ============================================
# Timezone (Optional)
# ============================================
# TZ=UTC

# ============================================
# Example Docker Run Command:
# ============================================
# docker run -d \
#   --name account-management \
#   --env-file .env \
#   -p 8080:8080 \
#   -v $(pwd)/logs:/app/logs \
#   account-management:latest
#
# ============================================
# Example Docker Compose Usage:
# ============================================
# In docker-compose.yml, use:
#   environment:
#     - SPRING_PROFILES_ACTIVE=prod
#     - SPRING_DATASOURCE_URL=${SPRING_DATASOURCE_URL}
#     - SPRING_DATASOURCE_USERNAME=${SPRING_DATASOURCE_USERNAME}
#     - SPRING_DATASOURCE_PASSWORD=${SPRING_DATASOURCE_PASSWORD}
#     - JWT_SECRET=${JWT_SECRET}
#   env_file:
#     - .env

